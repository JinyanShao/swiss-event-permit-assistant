<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swiss Event Permit Assistant</title>
    <script type="importmap"></script>
    <script defer data-domain="sepa-fribourg-jinyan.azurewebsites.net" src="https://plausible.io/js/script.outbound-links.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SwissEventPermitAssistant.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Aller au contenu principal</a>
    <header class="site-header">
        <a class="brand" asp-page="/Index">Swiss Event Permit Assistant</a>
        <span class="scope-label">Ville de Fribourg · V0.1</span>
    </header>
    <main id="main-content" class="page-shell" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>Service indépendant. Les exigences finales relèvent de l’autorité compétente.</p>
        <p>
            <a data-analytics-event="Feedback Click" href="mailto:jinyanshao@proton.me?subject=Retour%20Swiss%20Event%20Permit%20Assistant">Signaler une erreur ou donner un retour</a>
            ·
            <a data-analytics-event="Feedback Click" href="https://github.com/JinyanShao/swiss-event-permit-assistant/issues/new" target="_blank" rel="noreferrer">Retour technique</a>
            ·
            <a asp-page="/Privacy">Confidentialité</a>
        </p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
