<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swiss Event Permit Assistant</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SwissEventPermitAssistant.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">Swiss Event Permit Assistant</a>
        <span class="scope-label">Ville de Fribourg · V0.1</span>
    </header>
    <main class="page-shell" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>Service indépendant. Les exigences finales relèvent de l’autorité compétente.</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
