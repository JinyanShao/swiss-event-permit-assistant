@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<section class="hero hero-compact" aria-labelledby="error-title">
    <p class="kicker">Erreur</p>
    <h1 id="error-title">@Model.Heading</h1>
    <p class="lede">@Model.Message</p>
    <div class="hero-actions">
        <a class="button button-primary" asp-page="/Assessment">Reprendre le questionnaire</a>
        <a class="button button-secondary" asp-page="/Index">Retour à l’accueil</a>
    </div>
</section>

@if (Model.ShowRequestId)
{
    <p class="source-note">
        Référence technique: <code>@Model.RequestId</code>
    </p>
}
