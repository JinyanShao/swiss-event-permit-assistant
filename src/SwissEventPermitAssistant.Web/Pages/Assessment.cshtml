@page
@model SwissEventPermitAssistant.Web.Pages.AssessmentModel
@{
    ViewData["Title"] = "Évaluation";
}

<form id="assessmentForm" class="assessment" method="post" asp-page="/Results" novalidate>
    <input type="hidden" id="assessmentJson" name="AssessmentJson" />

    <div class="assessment-header">
        <div>
            <p class="eyebrow">Évaluation</p>
            <h1>Préparez votre manifestation</h1>
        </div>
        <div class="progress-readout" aria-live="polite">
            <span id="stepCounter">01 / 07</span>
            <span id="stepTitle">Périmètre</span>
        </div>
    </div>
    <div class="progress-track" aria-hidden="true"><span id="progressBar"></span></div>

    <section class="question-step is-active" data-step="0" data-title="Périmètre" tabindex="-1">
        <fieldset>
            <legend>Périmètre</legend>
            <div class="field-group" role="radiogroup" aria-labelledby="commune-label" aria-describedby="commune-help commune-error">
                <p id="commune-label" class="question-label">La manifestation aura-t-elle lieu sur le territoire de la Ville de Fribourg ?</p>
                <p id="commune-help" class="field-help">V0.1 couvre uniquement la Ville de Fribourg. En cas de doute, choisissez « Je ne sais pas ».</p>
                <label class="choice"><input type="radio" name="commune" value="VilleDeFribourg" required /> Oui</label>
                <label class="choice"><input type="radio" name="commune" value="Other" /> Non</label>
                <label class="choice"><input type="radio" name="commune" value="Unknown" /> Je ne sais pas</label>
                <span id="commune-error" class="field-error" role="alert">Sélectionnez une réponse.</span>
            </div>
        </fieldset>
    </section>

    <section class="question-step" data-step="1" data-title="Manifestation" tabindex="-1">
        <fieldset>
            <legend>Manifestation</legend>
            <label class="field">
                <span>Nom de la manifestation</span>
                <span id="eventName-help" class="field-help">Facultatif. Il sert uniquement à reconnaître votre résultat.</span>
                <input name="eventName" maxlength="120" autocomplete="off" aria-describedby="eventName-help" />
            </label>
            <label class="field">
                <span>Date de la manifestation</span>
                <span id="eventDate-help" class="field-help">Cette date sert à calculer les délais officiels.</span>
                <input name="eventDate" type="date" required aria-describedby="eventDate-help eventDate-error" />
                <span id="eventDate-error" class="field-error" role="alert">Indiquez une date de manifestation.</span>
            </label>
            <label class="field">
                <span>Heure de fin prévue</span>
                <span class="field-help">Facultatif. Utile si la manifestation se termine tard.</span>
                <input name="eventEndTime" type="time" />
            </label>
            <label class="field">
                <span>Nombre de personnes attendues</span>
                <span id="expectedAttendance-help" class="field-help">Une estimation suffit pour orienter les démarches et les délais applicables.</span>
                <input name="expectedAttendance" type="number" min="1" inputmode="numeric" required aria-describedby="expectedAttendance-help expectedAttendance-error" />
                <span id="expectedAttendance-error" class="field-error" role="alert">Indiquez une estimation du nombre de personnes attendues.</span>
            </label>
        </fieldset>
    </section>

    <section class="question-step" data-step="2" data-title="Lieu" tabindex="-1">
        <fieldset>
            <legend>Lieu</legend>
            <div class="field-group" role="radiogroup" aria-labelledby="venueKind-label" aria-describedby="venueKind-help venueKind-error">
                <p id="venueKind-label" class="question-label">Où la manifestation aura-t-elle lieu ?</p>
                <p id="venueKind-help" class="field-help">Par exemple, une rue, une place ou un parc lorsqu’ils relèvent du domaine public communal. Un lieu privé peut aussi être ouvert au public. En cas de doute, choisissez « Je ne sais pas ».</p>
                <label class="choice"><input type="radio" name="venueKind" value="PublicSpace" required /> Sur le domaine public communal</label>
                <label class="choice"><input type="radio" name="venueKind" value="PrivateVenue" /> Dans un lieu ou sur un fonds privé, par exemple un restaurant, un bar, une salle de concert ou un local associatif</label>
                <label class="choice"><input type="radio" name="venueKind" value="NotSure" /> Je ne sais pas</label>
                <span id="venueKind-error" class="field-error" role="alert">Sélectionnez une réponse.</span>
            </div>
            <div class="field-group" role="radiogroup" aria-labelledby="isPublicEvent-label" aria-describedby="isPublicEvent-help isPublicEvent-error">
                <p id="isPublicEvent-label" class="question-label">La manifestation est-elle ouverte au public ?</p>
                <p id="isPublicEvent-help" class="field-help">Cette réponse concerne l’accès à l’événement, pas le statut public ou privé du lieu.</p>
                <label class="choice"><input type="radio" name="isPublicEvent" value="Yes" required /> Oui</label>
                <label class="choice"><input type="radio" name="isPublicEvent" value="No" /> Non</label>
                <label class="choice"><input type="radio" name="isPublicEvent" value="Unknown" /> Je ne sais pas</label>
                <span id="isPublicEvent-error" class="field-error" role="alert">Sélectionnez une réponse pour l’accès à la manifestation.</span>
            </div>
        </fieldset>
    </section>

    <section class="question-step" data-step="3" data-title="Boissons et nourriture" tabindex="-1">
        <fieldset>
            <legend>Boissons et nourriture</legend>
            <div class="field-group" role="radiogroup" aria-labelledby="beverageMode-label" aria-describedby="beverageMode-error">
                <p id="beverageMode-label" class="question-label">Qu’en est-il des boissons ?</p>
                <label class="choice"><input type="radio" name="beverageMode" value="NoBeverages" required /> Aucune boisson</label>
                <label class="choice"><input type="radio" name="beverageMode" value="BeveragesSold" /> Des boissons seront vendues</label>
                <label class="choice"><input type="radio" name="beverageMode" value="BeveragesFree" /> Des boissons seront offertes gratuitement</label>
                <label class="choice"><input type="radio" name="beverageMode" value="NotSure" /> Je ne sais pas</label>
                <span id="beverageMode-error" class="field-error" role="alert">Sélectionnez une réponse pour les boissons.</span>
            </div>
            <div class="field-group" role="radiogroup" aria-labelledby="foodMode-label" aria-describedby="foodMode-error">
                <p id="foodMode-label" class="question-label">Qu’en est-il de la nourriture ?</p>
                <label class="choice"><input type="radio" name="foodMode" value="NoFood" required /> Aucune nourriture</label>
                <label class="choice"><input type="radio" name="foodMode" value="CookedFoodSold" /> Des mets cuisinés seront vendus</label>
                <label class="choice"><input type="radio" name="foodMode" value="OtherFoodSoldOrUnsure" /> Autre nourriture vendue</label>
                <label class="choice"><input type="radio" name="foodMode" value="FoodFree" /> De la nourriture sera offerte gratuitement</label>
                <label class="choice"><input type="radio" name="foodMode" value="NotSure" /> Je ne sais pas</label>
                <span id="foodMode-error" class="field-error" role="alert">Sélectionnez une réponse pour la nourriture.</span>
            </div>
            <div class="field-group" role="radiogroup" aria-labelledby="alcoholMode-label" aria-describedby="alcoholMode-error">
                <p id="alcoholMode-label" class="question-label">Y aura-t-il des boissons alcoolisées ?</p>
                <label class="choice"><input type="radio" name="alcoholMode" value="NoAlcohol" required /> Non</label>
                <label class="choice"><input type="radio" name="alcoholMode" value="AlcoholSold" /> Oui, vendues</label>
                <label class="choice"><input type="radio" name="alcoholMode" value="AlcoholFree" /> Oui, offertes gratuitement</label>
                <label class="choice"><input type="radio" name="alcoholMode" value="NotSure" /> Je ne sais pas</label>
                <span id="alcoholMode-error" class="field-error" role="alert">Sélectionnez une réponse pour les boissons alcoolisées.</span>
            </div>
            <p class="not-sure-note">Les réponses « Je ne sais pas » seront traitées comme des points à confirmer, pas comme des erreurs.</p>
        </fieldset>
    </section>

    <section class="question-step" data-step="4" data-title="Musique et installations" tabindex="-1">
        <fieldset>
            <legend>Musique et installations</legend>
            <div class="field-group" role="radiogroup" aria-labelledby="hasAmplifiedMusicOrSound-label" aria-describedby="hasAmplifiedMusicOrSound-error">
                <p id="hasAmplifiedMusicOrSound-label" class="question-label">Y aura-t-il de la musique amplifiée ou une sonorisation ?</p>
                <label class="choice"><input type="radio" name="hasAmplifiedMusicOrSound" value="Yes" required /> Oui</label>
                <label class="choice"><input type="radio" name="hasAmplifiedMusicOrSound" value="No" /> Non</label>
                <label class="choice"><input type="radio" name="hasAmplifiedMusicOrSound" value="Unknown" /> Je ne sais pas</label>
                <span id="hasAmplifiedMusicOrSound-error" class="field-error" role="alert">Sélectionnez une réponse pour la musique ou la sonorisation.</span>
            </div>
            <div class="field-group" role="radiogroup" aria-labelledby="hasTemporaryInstallations-label" aria-describedby="hasTemporaryInstallations-help hasTemporaryInstallations-error">
                <p id="hasTemporaryInstallations-label" class="question-label">Y aura-t-il des installations temporaires ?</p>
                <p id="hasTemporaryInstallations-help" class="field-help">Par exemple tente, scène, bar, cuisine, WC, gradins.</p>
                <label class="choice"><input type="radio" name="hasTemporaryInstallations" value="Yes" required /> Oui</label>
                <label class="choice"><input type="radio" name="hasTemporaryInstallations" value="No" /> Non</label>
                <label class="choice"><input type="radio" name="hasTemporaryInstallations" value="Unknown" /> Je ne sais pas</label>
                <span id="hasTemporaryInstallations-error" class="field-error" role="alert">Sélectionnez une réponse pour les installations temporaires.</span>
            </div>
            <div class="field-group" role="radiogroup" aria-labelledby="usesGasGrillOrHeater-label" aria-describedby="usesGasGrillOrHeater-error">
                <p id="usesGasGrillOrHeater-label" class="question-label">Utiliserez-vous un gril ou chauffage à gaz ?</p>
                <label class="choice"><input type="radio" name="usesGasGrillOrHeater" value="Yes" required /> Oui</label>
                <label class="choice"><input type="radio" name="usesGasGrillOrHeater" value="No" /> Non</label>
                <label class="choice"><input type="radio" name="usesGasGrillOrHeater" value="Unknown" /> Je ne sais pas</label>
                <span id="usesGasGrillOrHeater-error" class="field-error" role="alert">Sélectionnez une réponse pour le gaz.</span>
            </div>
        </fieldset>
    </section>

    <section class="question-step" data-step="5" data-title="Circulation" tabindex="-1">
        <fieldset>
            <legend>Circulation</legend>
            <div class="field-group" role="radiogroup" aria-labelledby="affectsTrafficOrParking-label" aria-describedby="affectsTrafficOrParking-error">
                <p id="affectsTrafficOrParking-label" class="question-label">La manifestation aura-t-elle un impact sur la circulation ou le stationnement ?</p>
                <label class="choice"><input type="radio" name="affectsTrafficOrParking" value="Yes" required /> Oui</label>
                <label class="choice"><input type="radio" name="affectsTrafficOrParking" value="No" /> Non</label>
                <label class="choice"><input type="radio" name="affectsTrafficOrParking" value="Unknown" /> Je ne sais pas</label>
                <span id="affectsTrafficOrParking-error" class="field-error" role="alert">Sélectionnez une réponse pour la circulation ou le stationnement.</span>
            </div>
            <div class="field-group" role="radiogroup" aria-labelledby="hasProcessionOrRoute-label" aria-describedby="hasProcessionOrRoute-error">
                <p id="hasProcessionOrRoute-label" class="question-label">Y aura-t-il un cortège, un parcours ou une occupation de route ?</p>
                <label class="choice"><input type="radio" name="hasProcessionOrRoute" value="Yes" required /> Oui</label>
                <label class="choice"><input type="radio" name="hasProcessionOrRoute" value="No" /> Non</label>
                <label class="choice"><input type="radio" name="hasProcessionOrRoute" value="Unknown" /> Je ne sais pas</label>
                <span id="hasProcessionOrRoute-error" class="field-error" role="alert">Sélectionnez une réponse pour le cortège, le parcours ou l’occupation de route.</span>
            </div>
            <div class="field-group" role="radiogroup" aria-labelledby="isSportCompetitionOnPublicRoad-label" aria-describedby="isSportCompetitionOnPublicRoad-error">
                <p id="isSportCompetitionOnPublicRoad-label" class="question-label">S’agit-il d’une compétition sportive sur la voie publique ?</p>
                <label class="choice"><input type="radio" name="isSportCompetitionOnPublicRoad" value="Yes" required /> Oui</label>
                <label class="choice"><input type="radio" name="isSportCompetitionOnPublicRoad" value="No" /> Non</label>
                <label class="choice"><input type="radio" name="isSportCompetitionOnPublicRoad" value="Unknown" /> Je ne sais pas</label>
                <span id="isSportCompetitionOnPublicRoad-error" class="field-error" role="alert">Sélectionnez une réponse pour la compétition sportive.</span>
            </div>
        </fieldset>
    </section>

    <section class="question-step" data-step="6" data-title="Vérification" tabindex="-1">
        <fieldset>
            <legend>Vérification</legend>
            <div class="field-group" role="radiogroup" aria-labelledby="hasLiabilityInsurance-label" aria-describedby="hasLiabilityInsurance-help hasLiabilityInsurance-error">
                <p id="hasLiabilityInsurance-label" class="question-label">Avez-vous une assurance responsabilité civile valable ?</p>
                <p id="hasLiabilityInsurance-help" class="field-help">La Ville indique que l’organisateur doit pouvoir présenter une RC valable.</p>
                <label class="choice"><input type="radio" name="hasLiabilityInsurance" value="Yes" required /> Oui</label>
                <label class="choice"><input type="radio" name="hasLiabilityInsurance" value="No" /> Non</label>
                <label class="choice"><input type="radio" name="hasLiabilityInsurance" value="Unknown" /> Je ne sais pas</label>
                <span id="hasLiabilityInsurance-error" class="field-error" role="alert">Sélectionnez une réponse pour l’assurance responsabilité civile.</span>
            </div>
            <div class="field-group">
                <p class="question-label">Matériel ou décorations communales</p>
                <label class="checkline"><input type="checkbox" name="needsMunicipalMaterialOrDecorations" /> J’ai besoin de matériel ou de décorations communales.</label>
            </div>
            <div class="field-group">
                <p class="question-label">Affichage public ou banderole</p>
                <label class="checkline"><input type="checkbox" name="needsAdvertisingBannerOrPublicPosting" /> J’ai besoin d’affichage public ou d’une banderole.</label>
            </div>
        </fieldset>
    </section>

    <div class="navigation-actions">
        <button class="button button-secondary" type="button" id="previousStep">Retour</button>
        <button class="button button-primary" type="button" id="nextStep">Continuer</button>
        <button class="button button-primary" type="submit" id="submitAssessment" hidden>Voir le résultat</button>
    </div>
</form>
